<%- include('partials/header') %>
<div class="page-head"><h1>Documents de la copropriété</h1><p class="muted">PV d'assemblées générales, règlement, comptes annuels, contrats… Consultables uniquement par les résidents.</p></div>

<% if (user.role === 'admin') { %>
<details class="card admin-box">
  <summary>➕ Ajouter un document</summary>
  <form method="post" action="/documents?_csrf=<%= csrfToken %>" enctype="multipart/form-data" class="form">
    <label>Titre<input name="title" required maxlength="200" placeholder="PV AG ordinaire du 12 juin 2026"></label>
    <label>Catégorie<select name="category"><% for (const [k, v] of Object.entries(h.DOCUMENT_CATEGORIES)) { %><option value="<%= k %>"><%= v %></option><% } %></select></label>
    <label>Fichier (PDF, image, Word, Excel — 15 Mo max)<input type="file" name="file" required accept=".pdf,.png,.jpg,.jpeg,.doc,.docx,.xls,.xlsx,.odt,.ods"></label>
    <button class="btn btn-primary">Envoyer</button>
  </form>
</details>
<% } %>

<% const cats = Object.keys(grouped); if (!cats.length) { %><div class="card empty">Aucun document pour le moment.</div><% } %>
<% for (const [k, label] of Object.entries(h.DOCUMENT_CATEGORIES)) { if (!grouped[k]) continue; %>
<section class="card">
  <h2><%= label %></h2>
  <ul class="doc-list">
  <% for (const d of grouped[k]) { %>
    <li>
      <span class="doc-ico"><%= (d.original_name.split('.').pop() || '').toUpperCase().slice(0, 4) %></span>
      <div class="doc-info"><a href="/documents/<%= d.id %>/telecharger"><%= d.title %></a><span class="muted small"><%= h.date(d.created_at) %> · <%= h.fileSize(d.size) %></span></div>
      <% if (user.role === 'admin') { %>
        <form method="post" action="/documents/<%= d.id %>/supprimer" data-confirm="Supprimer ce document ?"><%- include('partials/csrf') %><button class="link danger small">Supprimer</button></form>
      <% } %>
    </li>
  <% } %>
  </ul>
</section>
<% } %>
<%- include('partials/footer') %>

# Clé secrète qui signe les sessions de connexion. Mets une longue chaîne aléatoire en production.
SESSION_SECRET=remplace-moi-par-une-longue-chaine-aleatoire-de-plus-de-32-caracteres
# Mets "true" uniquement si le site est servi en HTTPS (en production).
COOKIE_SECURE=false
# Emplacement de la base (optionnel)
# DATABASE_PATH=./data/syndic.db
